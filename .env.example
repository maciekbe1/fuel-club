# Fuel Club - environment variables (names as the API reads them: ":" becomes "__").
# Not loaded automatically. Locally prefer user-secrets (README); this file lists what a server
# or a shell needs:  set -a; . ./.env; set +a
# Never commit a filled-in .env.

# --- API (apps/api) ---
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__DefaultConnection=Host=localhost;Port=5433;Database=fuelclub;Username=fuelclub;Password=fuelclub_local

# Optional demo accounts (anna@, bartek@, kasjer@, admin@demo.fuelclub.test), one shared password.
DemoAccounts__Enabled=true
DemoAccounts__Password=<demo-password>

# Optional real staff accounts created at startup (both values or none).
# BootstrapAdmin__Email=admin@example.test
# BootstrapAdmin__Password=<strong-password>
# BootstrapCashier__Email=kasjer@example.test
# BootstrapCashier__Password=<strong-password>
# BootstrapCashier__StationCode=ST-01
# BootstrapCashier__RegisterCode=K1

# Required outside Development: HMAC key for user pseudonyms in traces (min. 32 bytes, base64).
# Assistant__PseudonymKey=<base64-32-bytes>

# Optional OTLP/HTTP trace export, e.g. the local Phoenix (docker compose --profile observability up -d phoenix).
# Telemetry__OtlpEndpoint=http://localhost:6006/v1/traces

# Proxies trusted for X-Forwarded-For besides loopback (login rate limit per client address).
# ForwardedHeaders__KnownProxies__0=10.0.0.5
# Next in another container: its network as CIDR.
# ForwardedHeaders__KnownNetworks__0=172.16.0.0/12

# Required outside Development: certificate encrypting the Data Protection keys stored in the database
# (base64 PKCS#12; see docs "Obrazy i hosting").
# DataProtection__Certificate=<base64-pfx>
# DataProtection__CertificatePassword=<pfx-password>

# --- Web (apps/web) ---
# Where Next forwards /api/* (server side only).
API_INTERNAL_URL=http://localhost:5271
# Only behind an edge proxy that sets X-Forwarded-For and X-Forwarded-Proto; otherwise both are dropped (ADR 0009).
# TRUST_FORWARDED_FOR=true
